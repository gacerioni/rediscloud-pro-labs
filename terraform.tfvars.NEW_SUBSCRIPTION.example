# Example configuration for creating a NEW subscription with a database

# Redis Cloud API credentials
redis_global_api_key        = "your-api-key-here"
redis_global_secret_key     = "your-secret-key-here"

# Subscription creation mode
create_subscription         = true  # Create a new subscription

# Subscription settings
subscription_name           = "pro-sub-workshop"
cloud_account_id            = "1"
networking_deployment_cidr  = "10.123.42.0/24"

# Billing settings
billing_mode                = "credit-card"  # or "marketplace"
card_type                   = "Mastercard"   # Only needed for credit-card mode

# Database settings
database_name               = "my-redis-db"
redis_version               = "8.2"
dataset_size_in_gb          = 1
throughput_measurement_value= 1000
replication                 = false
enable_tls                  = false
user_password               = "YourSecurePassword123!"
dataset_size_alert_percentage = 95

# Environment and region
environment                 = "dev"  # Maps to us-east-1 by default
# region                    = "us-west-2"  # Uncomment to override default region

# Tags
tags = {
  environment = "dev"
  project     = "my-project"
  owner       = "your-name"
}

# PrivateLink configuration
private_link_share_name = "my-privatelink-share"

private_link_principals = [
  {
    principal       = "123456789012"   # AWS account ID
    principal_type  = "aws_account"
    principal_alias = "my-aws-account"
  }
]

